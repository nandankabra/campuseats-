<?xml version="1.0" encoding="UTF-8"?>
<!--
  SOAP 1.1 Fault returned by the external UniPay partner when the charge
  operation cannot be completed because the issuing bank declined the card.

  Design-time sample only; the <detail> content conforms to the ChargeFault
  element declared in partner.wsdl and bound to the "ChargeFault" fault of
  the charge operation.

  NOTE: "card_declined" is UniPay's private vocabulary. The CampusEats
  integration adapter maps it to PAYMENT_DECLINED before it reaches any
  CampusEats consumer. See integration.pdf, section 4 (Fault Mapping).
-->
<soapenv:Envelope
    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:pay="http://unipay.example.com/payment/v1">

  <soapenv:Body>
    <soapenv:Fault>
      <faultcode>soapenv:Client</faultcode>
      <faultstring>Payment declined by issuing bank</faultstring>
      <faultactor>https://api.unipay.example.com/soap/payment</faultactor>
      <detail>
        <pay:ChargeFault>
          <pay:faultCode>card_declined</pay:faultCode>
          <pay:faultReason>The issuing bank declined this card.</pay:faultReason>
          <pay:orderId>CE1001</pay:orderId>
        </pay:ChargeFault>
      </detail>
    </soapenv:Fault>
  </soapenv:Body>

</soapenv:Envelope>
